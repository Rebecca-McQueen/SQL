-- For this project, I downloaded Spotify data from Kaggle.
-- Then I created a table to insert Spotify data into.
-- Finally, I performed analytics on the data using SQL. 

--Creating the table: 
CREATE TABLE BIT_DB.Spotifydata (
id integer PRIMARY KEY,
artist_name varchar NOT NULL,
track_name varchar NOT NULL,
track_id varchar NOT NULL,
popularity integer NOT NULL,
danceability decimal(4,3) NOT NULL,
energy decimal(4,3) NOT NULL,
key integer NOT NULL,
loudness decimal(5,3) NOT NULL,
mode integer NOT NULL,
speechiness decimal(5,4) NOT NULL,
acousticness decimal(6,5) NOT NULL,
instrumentalness text NOT NULL,
liveness decimal(5,4) NOT NULL,
valence decimal(4,3) NOT NULL,
tempo decimal(6,3) NOT NULL,
duration_ms integer NOT NULL,
time_signature integer NOT NULL 
)

--Then I inserted the Spotify Data .csv into the table.

--Next, I explored the data using the following SQL. 

-- What are the top 10 most popular songs?
SELECT artist_name, track_name
FROM Spotifydata
Order by popularity DESC
LIMIT 10;

-- What are the top party songs? (highest energy and danceability combo).
Select artist_name, track_name, energy, danceability,
(energy + danceability) AS party_score
FROM Spotifydata
ORDER BY party_score DESC
LIMIT 10;

-- Build a 'chill study playlist' (based on low energy, high acousticness).
SELECT artist_name, track_name, energy, acousticness,
(acousticness - energy) AS chill_score
FROM Spotifydata 
ORDER BY chill_score DESC
LIMIT 10;

-- Are short songs becoming more popular? (ANS - We do not have year/date data as a comparative measure, however the following query highlights the number of songs, divided into 'short' (3mins or less) or 'long' (over 3 mins) to determine what type of song is more popoular. Although more long songs have made the top 50, their overall average popularity score remaims similair).
SELECT 
CASE WHEN duration_ms <180000 THEN 'Short'
ELSE 'Long'
END AS song_length,
AVG(popularity) AS avg_populaity,
COUNT(*) AS num_songs 
FROM Spotifydata
GROUP BY song_length;


